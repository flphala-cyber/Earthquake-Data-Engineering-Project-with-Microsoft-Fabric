# Default baseline values used for testing inside the notebook directly
start_date = "2026-01-01"
end_date = "2026-01-02"

---

import requests
import json

# Ensure variables are populated
if not start_date or not end_date:
    raise ValueError("Pipeline Execution Error: 'start_date' and 'end_date' must be provided by Data Factory.")

# Construct the API URL formatted for geojson output
url = f"https://earthquake.usgs.gov/fdsnws/event/1/query?format=geojson&starttime={start_date}&endtime={end_date}"

print(f"Initiating request to USGS API for window: {start_date} to {end_date}...")

try:
    # Fetch data with an explicit timeout to prevent hanging pipeline runs
    response = requests.get(url, timeout=30)
    
    # Check if HTTP request was successful (Throws an exception for 4xx/5xx responses)
    response.raise_for_status()
    
    # Parse the payload and isolate target feature arrays
    payload = response.json()
    features = payload.get('features', [])
    
    if not features:
        print(f"Warning: API request returned 0 earthquake events for the range {start_date} to {end_date}.")
    
    # Format target OneLake file paths using Fabric's native structure
    target_path = f"Files/{start_date}_earthquake_data.json"
    full_lakehouse_path = f"abfss://{notebookutils.lakehouse.get('default')['id']}@{notebookutils.lakehouse.get('default')['workspaceId']}.dfs.core.windows.net/{target_path}"
    
    # Serialize JSON payload as string
    json_string = json.dumps(features, indent=4)
    
    # Securely stream directly into Microsoft OneLake via standard Fabric utilities
    notebookutils.fs.put(full_lakehouse_path, json_string, True)
    print(f"Success! Ingested {len(features)} records. Saved securely to: {target_path}")

except requests.exceptions.RequestException as e:
    raise RuntimeError(f"Pipeline Ingestion Failed during HTTP extraction: {e}")
except Exception as e:
    raise RuntimeError(f"Pipeline Storage Failure during OneLake serialization: {e}")

